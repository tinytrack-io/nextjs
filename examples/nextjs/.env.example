# Browser settings must be present at build time and match the running Proxy.
TINYTRACK_WEBSITE_ID=your_website_id
# TINYTRACK_DOMAIN=example.com
# TINYTRACK_PATH_PREFIX=/_tinytrack
# TINYTRACK_SERVER_PAGEVIEWS=true
# TINYTRACK_ENABLED=true
# TINYTRACK_DEBUG=false
# Trust forwarded IP/protocol headers only when your ingress controls them.
# TINYTRACK_TRUST_PROXY=1
# TINYTRACK_GEO_HEADERS=country_iso:x-geo-country,city_name:x-geo-city
