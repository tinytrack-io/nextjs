{
	"name": "@tinytrack/nextjs",
	"version": "0.1.0",
	"description": "TinyTrack server-side analytics, first-party tracking endpoints, and automatic browser tracker injection for Next.js.",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./script": {
			"types": "./dist/script.d.ts",
			"import": "./dist/script.js",
			"default": "./dist/script.js"
		},
		"./next": {
			"types": "./dist/next.d.ts",
			"import": "./dist/next.js",
			"default": "./dist/next.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"import": "./dist/client.js",
			"default": "./dist/client.js"
		}
	},
	"files": [
		"dist",
		"src",
		"docs",
		"README.md",
		"LICENSE"
	],
	"sideEffects": [
		"./dist/client.js",
		"./src/client.ts"
	],
	"engines": {
		"node": ">=20.9.0"
	},
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"format:check": "prettier --check .",
		"example:dev": "npm run dev --workspace @tinytrack/nextjs-example",
		"example:build": "npm run build --workspace @tinytrack/nextjs-example",
		"example:smoke": "node scripts/smoke-nextjs.mjs",
		"prepublishOnly": "npm run typecheck && npm test && npm run build"
	},
	"workspaces": [
		"examples/nextjs"
	],
	"peerDependencies": {
		"next": "^16.0.0"
	},
	"devDependencies": {
		"@types/jsdom": "^30.0.0",
		"@types/node": "^22.0.0",
		"@types/react": "^19.2.18",
		"jsdom": "^26.1.0",
		"next": "^16.3.4",
		"prettier": "^3.0.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8"
	},
	"keywords": [
		"tinytrack",
		"analytics",
		"nextjs",
		"proxy",
		"middleware",
		"server-side-tracking"
	],
	"homepage": "https://tinytrack.io",
	"publishConfig": {
		"access": "public"
	},
	"license": "MIT"
}
