{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"strict": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"ignoreDeprecations": "6.0",
		"types": ["node"],
		"paths": {
			"@tinytrack/nextjs": ["./src/index.ts"],
			"@tinytrack/nextjs/script": ["./src/script.ts"],
			"@tinytrack/nextjs/next": ["./src/next.ts"],
			"@tinytrack/nextjs/client": ["./src/client.ts"]
		}
	},
	"include": ["src/**/*.ts", "test/**/*.ts", "tsup.config.ts", "vitest.config.ts"],
	"exclude": ["node_modules", "dist", "examples"]
}
